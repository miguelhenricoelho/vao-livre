# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.

# Banco local (Docker)
POSTGRES_DB=vaolivre
POSTGRES_USER=vaolivre
POSTGRES_PASSWORD=

# Primeiro acesso: o sistema cria este administrador e a senha da área
# na primeira vez que sobe com o banco vazio.
APP_ADMIN_NOME=
APP_ADMIN_EMAIL=
APP_ADMIN_SENHA=
APP_SENHA_AREA=

# Só no perfil dev: senha do operador de exemplo (operador@vaolivre.exemplo)
APP_OPERADOR_EXEMPLO_SENHA=

# Mostra as etiquetas [REVISAR COM O CLIENTE] na tela (true/false)
MODO_REVISAO=false

# Opcional: chave gratuita da NVD para o Dependency-Check rodar mais rápido
NVD_API_KEY=

# Produção (Render): conexão com o banco
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
